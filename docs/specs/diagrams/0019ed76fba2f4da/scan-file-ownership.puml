@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam activity {
  BorderColor #486581
  FontColor #102A43
  BackgroundColor #F0F4F8
}
skinparam arrowColor #334E68

start
:For each generated path;
if (resolves inside repository?) then (no)
  :skip: outside the repository;
elseif (file exists?) then (no)
  :write with marker;
elseif (regular file?) then (no)
  :skip: not a regular file;
elseif (first line is xfeat marker?) then (yes)
  :write with marker;
elseif (opens like a pre-marker page?) then (yes)
  :write with marker;
else (no)
  :skip: not generated by xfeat;
endif
:status.documents = written pages;
:result.skipped = skipped paths;
stop
@enduml
